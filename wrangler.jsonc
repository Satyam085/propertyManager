{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "property-manager",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "property-manager",
      // replace with the id printed by `wrangler d1 create property-manager` before deploying
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "property-manager-files" }],
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
  ],
}
