{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "property-manager",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "observability": { "enabled": true },
  // the app reads env.DB and env.FILES; don't let `wrangler d1/r2 create` add second bindings
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "property-manager",
      "database_id": "a17eee5f-5eeb-4d59-b5a9-706891d30e41",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "property-manager-files" }],
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
  ],
}
